{
  "name": "anyang-apt-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:sync": "tsx scripts/sync-molit.ts",
    "db:sync:anyang": "tsx scripts/sync-molit.ts --scope=anyang --trade-months=240 --rent-months=48",
    "db:sync:featured": "tsx scripts/sync-molit.ts --scope=featured --trade-months=240 --rent-months=48",
    "db:sync:fresh": "tsx scripts/sync-molit.ts --scope=all --trade-months=4 --rent-months=2 --skip-existing=0 --only-changed=1",
    "db:sync:backfill": "tsx scripts/sync-molit.ts --scope=all --trade-months=120 --rent-months=48 --concurrency=1 --skip-existing=1 --only-changed=0",
    "db:sync:nationwide-plan": "tsx scripts/sync-molit.ts --scope=nationwide --trade-months=3 --rent-months=0 --plan=1",
    "db:estimate-nationwide": "tsx scripts/estimate-nationwide.ts",
    "db:probe": "tsx scripts/probe-molit-freshness.ts",
    "db:catalog": "tsx scripts/rebuild-apt-catalog.ts",
    "db:market": "tsx scripts/rebuild-market-home.ts",
    "db:stats": "tsx scripts/rebuild-market-stats.ts",
    "db:feeds": "tsx scripts/rebuild-market-stats-feeds.ts",
    "test:sync-dirty": "tsx scripts/test-sync-dirty-check.ts",
    "test:first-seen": "tsx scripts/test-first-seen-guard.ts",
    "test:late-report": "tsx scripts/test-late-report-ingestion.ts",
    "test:trade-resolve": "tsx scripts/test-trade-resolve.ts",
    "test:ingestion": "tsx scripts/test-sync-dirty-check.ts && tsx scripts/test-first-seen-guard.ts && tsx scripts/test-late-report-ingestion.ts && tsx scripts/test-trade-resolve.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.102.8",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
