# 공공데이터포털 일반 인증키 (Encoding 또는 Decoding 키)
# https://www.data.go.kr 에서
# 「국토교통부_아파트매매 실거래가 상세 자료」 / 「아파트 전월세」 API 활용신청 후 발급
MOLIT_API_KEY=여기에_발급받은_서비스키_입력

# 서울 열린데이터광장 OpenAPI 인증키 (금리비교 / dreamMoney · OA-21098)
# https://data.seoul.go.kr/together/mypage/actkeyMain.do 에서 발급
# 비우면 sample 키(최대 5건). Vercel Production/Preview에도 동일 이름으로 설정
SEOUL_OPENAPI_KEY=

# (선택) 개발 시 강제 목데이터 사용
# USE_MOCK_DATA=true

# Turso (libSQL) 웨어하우스 — 없으면 라이브 MOLIT 폴백
# 로컬: file:./data/molit.db
# 클라우드: libsql://your-db.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# (선택) /api/db-status 보호
# SYNC_ADMIN_SECRET=
