# 공공데이터포털 일반 인증키 (Encoding 또는 Decoding 키) — server-only, never NEXT_PUBLIC_*
# https://www.data.go.kr 에서
# 「국토교통부_아파트매매 실거래가 상세 자료」 / 「아파트 전월세」 /
# 「전국버스정류소표준데이터」(TAGO 버스정류소정보) 활용신청 후 발급
MOLIT_API_KEY=여기에_발급받은_서비스키_입력

# 서울 열린데이터광장 OpenAPI 인증키 (금리비교 / dreamMoney · OA-21098)
# https://data.seoul.go.kr 에서 발급. 미설정 시 sample 키(최대 5건)로 동작
# SEOUL_OPENAPI_KEY=

# (선택) 개발 시 강제 목데이터 사용
# USE_MOCK_DATA=true

# Turso (libSQL) 웨어하우스 — 없으면 라이브 MOLIT 폴백
# 로컬: file:./data/molit.db
# 클라우드: libsql://your-db.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# (선택) /api/db-status 보호
# SYNC_ADMIN_SECRET=

# --- Phase 8.1 주변환경·학군 지도 (NAVER = 2D renderer only) ---
# Browser-visible Client ID for Web Dynamic Map. Never put Client Secret here.
# NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# VWorld public GIS (geocode + place search for POI). Server-side preferred.
# VWORLD_API_KEY=

# NEIS OpenAPI — schoolInfo structured data (nearby schools, not catchment).
# NEIS_API_KEY=

# --- Living tab: NAVER Local Search / API HUB (server-only; never NEXT_PUBLIC_*) ---
# Maps Client ID is NOT valid for Local Search. No legacy Developers keys.
# Endpoint: https://naverapihub.apigw.ntruss.com/search/v1/local
# Headers: X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
# NAVER_API_HUB_CLIENT_ID=
# NAVER_API_HUB_CLIENT_SECRET=

# SchoolInfo (학교알리미) OpenAPI — server-only school detail
# https://www.schoolinfo.go.kr
# SCHOOLINFO_API_KEY=
