# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local MOLIT warehouse
/data/*.db
/data/*.db-*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# national coordinate cache (manifest is tracked; raw extracts are not)
/data/poc/national-expansion/coordinates/cache/

# NAVER map-anchor geocode runs (local review files)
data/map-anchor/

# SEMAS national store zip + local commerce build (large, regenerable)
/data/semas/

# local API page caches (resumable; not source)
/data/supply-fill-cache/
/data/profile-fill-cache/

# type-dong-links raw API cache
/data/poc/type-dong-links/cache/

# 서울 3D 건물 타일 (scripts/map3d로 만들고 Vercel Blob에 올린다 — 수십 MB라 git에 넣지 않음)
/public/map3d/*.pmtiles
